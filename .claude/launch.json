{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wireframe",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8888", "--directory", "wireframes"],
      "port": 8888
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend", "--", "--port", "5199", "--strictPort"],
      "port": 5199,
      "autoPort": false
    }
  ]
}
